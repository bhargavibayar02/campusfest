NODE_ENV=production
API_PORT=4000
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/campusfest?retryWrites=true&w=majority
JWT_SECRET=
FRONTEND_URL=https://campusfest-og4t.vercel.app
ADMIN_BOOTSTRAP_KEY=

# Optional email notifications. Leave all SMTP fields blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Set these unique development-only passwords before running npm run seed.
SEED_STUDENT_PASSWORD=
SEED_ORGANISER_PASSWORD=
SEED_VOLUNTEER_PASSWORD=
SEED_ADMIN_PASSWORD=

# One-time production organiser provisioning from a trusted local machine only.
# Remove these values immediately after running npm run provision:organiser -w api.
PROVISION_ORGANISER_NAME=
PROVISION_ORGANISER_EMAIL=
PROVISION_ORGANISER_PASSWORD=
